# Camara local. Nunca subir el .env real a Git.
CAMERA_NAME=CAMARA_01
CAMERA_RTSP_URL=rtsp://usuario:clave@192.168.1.100:554/stream1
RECONNECT_SECONDS=3

# Valores locales de respaldo. En cliente V3 administrado,
# el servidor define la sucursal y camara reales.
BRANCH_ID=1

# URL central. En otra sucursal NO usar 127.0.0.1.
# IMPORTANTE: debe terminar en /api.
API_URL=http://127.0.0.1:8000/api
API_TIMEOUT_SECONDS=5

# V3: copiar EXACTAMENTE los valores generados desde
# Administracion > Clientes. No usar valores de ejemplo.
CLIENT_ID=
CLIENT_TOKEN=

# Compatibilidad V2; dejar vacio en clientes V3.
API_TOKEN=

# Interfaz del cliente.
# false = muestra la camara; true = totalmente oculto.
HEADLESS=false
# true = al minimizar o cerrar la X, queda en iconos ocultos de Windows.
TRAY_MODE=true

# Rendimiento cuando la ventana esta abierta.
PROCESS_FPS=12
YOLO_IMGSZ=640

# Rendimiento automatico cuando queda en iconos ocultos o HEADLESS=true.
# Estos valores reducen mucho el consumo sin desactivar el conteo.
BACKGROUND_PROCESS_FPS=5
BACKGROUND_YOLO_IMGSZ=512

# Maximo de hilos de PyTorch cuando YOLO trabaja con CPU.
# 2 es un valor seguro para notebooks; subir a 3 o 4 en equipos potentes.
YOLO_CPU_THREADS=2

APP_VERSION=3.0.0
SYNC_INTERVAL_SECONDS=5
SYNC_BATCH_SIZE=100
HEARTBEAT_INTERVAL_SECONDS=20
REMOTE_CONFIG_INTERVAL_SECONDS=30
