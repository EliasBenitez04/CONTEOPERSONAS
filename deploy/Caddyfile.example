# Reemplazar conteo.midominio.com por el dominio real.
# Caddy obtiene y renueva certificados HTTPS automaticamente
# cuando DNS apunta a este servidor y los puertos 80/443 estan abiertos.

conteo.midominio.com {
    encode gzip

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "same-origin"
    }

    reverse_proxy 127.0.0.1:8000
}
