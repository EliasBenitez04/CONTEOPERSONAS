APP_NAME=SISTEMA CAMARA - API CENTRAL
API_PREFIX=/api

# PostgreSQL 9.x
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=contepersonas
PG_USER=postgres
PG_PASSWORD=postgres

# Opcional: si definis DATABASE_URL, reemplaza los valores PG_* de arriba.
# DATABASE_URL=postgresql+psycopg2://postgres:tu_clave@127.0.0.1:5432/contepersonas

# API tecnica usada por los clientes de camara.
# En produccion configura el mismo token aqui y en client/.env.
API_TOKEN=

# Seguridad web / sesiones.
# CAMBIAR por una cadena larga y aleatoria antes de produccion.
SESSION_SECRET=cambiar-esta-clave-sistema-camara-2026
SESSION_HOURS=12

# Solo se usan para crear el PRIMER usuario cuando la tabla users esta vacia.
# La clave inicial debe cambiarse en el primer ingreso.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrador
