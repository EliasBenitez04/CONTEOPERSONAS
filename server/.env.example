APP_NAME=SISTEMA CAMARA - API CENTRAL
API_PREFIX=/api
ENVIRONMENT=development
PUBLIC_BASE_URL=http://127.0.0.1:8000

# Produccion: desactiva Swagger, usa cookie Secure y limita hosts.
ENABLE_DOCS=1
SESSION_COOKIE_SECURE=0
TRUSTED_HOSTS=*

# PostgreSQL 9.x
PG_HOST=127.0.0.1
PG_PORT=5432
PG_DATABASE=contepersonas
PG_USER=postgres
PG_PASSWORD=postgres

# Si pg_dump no esta en PATH, indicar la carpeta bin de PostgreSQL.
# PG_BIN=C:\Program Files\PostgreSQL\9.6\bin
BACKUP_RETENTION_DAYS=30

# Opcional: reemplaza los valores PG_*.
# DATABASE_URL=postgresql+psycopg2://postgres:tu_clave@127.0.0.1:5432/contepersonas

# Compatibilidad V2. En V3 cada cliente usa CLIENT_ID + CLIENT_TOKEN propio.
API_TOKEN=

# Seguridad web / sesiones. CAMBIAR por una cadena larga y aleatoria.
SESSION_SECRET=cambiar-esta-clave-sistema-camara-2026
SESSION_HOURS=12

# Solo se usan para crear el PRIMER usuario si users esta vacia.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin123!
ADMIN_FULL_NAME=Administrador

# Ejemplo recomendado en produccion:
# ENVIRONMENT=production
# PUBLIC_BASE_URL=https://conteo.midominio.com
# ENABLE_DOCS=0
# SESSION_COOKIE_SECURE=1
# TRUSTED_HOSTS=conteo.midominio.com,127.0.0.1
